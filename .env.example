# codepilot configuration
# -----------------------
# Copy to .env and edit:   cp .env.example .env
# codepilot reads ./.env automatically (no need to `source` it). Real environment variables override it.
# .env is git-ignored: put secrets (API keys) here, never in .env.example.
# Full reference: docs/configuration.md      Check your setup:  make doctor

# =============================================================================================
# 1. Pick a model provider
# =============================================================================================
#   bedrock    Claude on Amazon Bedrock, using your AWS credentials (typical for company use)
#   anthropic  Claude via the Anthropic API, using your own ANTHROPIC_API_KEY
#   openai     OpenAI (or an OpenAI-compatible endpoint), using your own OPENAI_API_KEY
#   ollama     A free local model via Ollama (for trying codepilot out; weak at real work)
CODEPILOT_PROVIDER=bedrock

# Model tiers: "fast" (sub-agent searches, summaries), "main" (default), "hard" (difficult problems).
# You pick the tier per session in the UI.
CODEPILOT_DEFAULT_TIER=auto
CODEPILOT_MAX_TOKENS=16000

# =============================================================================================
# 2a. Amazon Bedrock            (docs/setup.md#amazon-bedrock)
# =============================================================================================
# AWS credentials come from the standard AWS chain. Recommended: an SSO profile.
#   aws configure sso            # once, creates the profile
#   aws sso login --profile your-sso-profile
AWS_PROFILE=your-sso-profile
AWS_REGION=us-east-1
# Models. Claude 5.x uses the Bedrock Messages API (anthropic.* IDs); older inference-profile IDs
# (us./eu./global.anthropic...) use Converse. Mixing is fine. `uv run codepilot models --refresh` lists what
# your account can use; tiers whose model isn't enabled fall back to the best enabled one in the family.
CODEPILOT_MODEL_FAST=anthropic.claude-haiku-5-5
CODEPILOT_MODEL_MAIN=anthropic.claude-sonnet-5-5
CODEPILOT_MODEL_HARD=anthropic.claude-opus-5-5
# Prompt caching (big saving on the tool loop). Auto-disables if a model rejects it.
CODEPILOT_PROMPT_CACHE=1
# Extended thinking on Bedrock: off | adaptive (Claude 4.6+ models) | a token budget like 4000 (4.5 models)
CODEPILOT_THINKING=off
# Optional: VPC/PrivateLink endpoint for bedrock-runtime
# CODEPILOT_BEDROCK_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# =============================================================================================
# 2b. Anthropic API (your own key)   (docs/setup.md#anthropic-api)
# =============================================================================================
# Create a key at https://console.anthropic.com/ -> API keys. Keep it only in .env.
# ANTHROPIC_API_KEY=sk-ant-...
# Defaults: fast=claude-haiku-5-5, main=claude-sonnet-5-5, hard=claude-opus-5-5. Override per tier:
# CODEPILOT_ANTHROPIC_MODEL_MAIN=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max   (default high for coding work)
# CODEPILOT_EFFORT=high

# =============================================================================================
# 2c. OpenAI API (your own key)      (docs/setup.md#openai-api)
# =============================================================================================
# Create a key at https://platform.openai.com/api-keys. Keep it only in .env.
# OPENAI_API_KEY=sk-...
# Required: the model to use (run `make doctor` to list the models your key can access).
# CODEPILOT_OPENAI_MODEL=
# Optional per-tier overrides: CODEPILOT_OPENAI_MODEL_FAST / _MAIN / _HARD
# Optional: an OpenAI-compatible endpoint (LiteLLM, OpenRouter, vLLM, Azure OpenAI v1 API, ...)
# CODEPILOT_OPENAI_BASE_URL=https://...

# =============================================================================================
# 2d. Ollama (free, local)           (docs/setup.md#ollama)
# =============================================================================================
# CODEPILOT_OLLAMA_URL=http://localhost:11434
# CODEPILOT_OLLAMA_MODEL=llama3.2:3b

# =============================================================================================
# 3. Network (corporate proxies and TLS inspection)
# =============================================================================================
# Verify TLS against the OS trust store (macOS Keychain / Windows store). Handles TLS-inspecting proxies.
CODEPILOT_SYSTEM_CERTS=1
# ...or point at a CA bundle file instead:
# CODEPILOT_CA_BUNDLE=/path/to/corporate-ca.pem
# Standard proxy variables are honoured by every provider:
# HTTPS_PROXY=http://proxy.example.com:8080
# uv doesn't read this file. The Makefile already makes uv trust the OS certificate store
# (UV_SYSTEM_CERTS / UV_NATIVE_TLS). Without make: `uv sync --system-certs` (uv < 0.11: `--native-tls`).

# =============================================================================================
# 4. GitHub (optional)               (docs/setup.md#github)
# =============================================================================================
# Uses the GitHub CLI's own login (`gh auth login`); codepilot never sees a token.
CODEPILOT_GITHUB=1
# GitHub Enterprise Server host (after `gh auth login --hostname <host>`):
# CODEPILOT_GH_HOST=github.example.com

# =============================================================================================
# 5. Workspace defaults (all optional; you can name any folder in chat or the UI)
# =============================================================================================
# CODEPILOT_REPO="~/code/my-service"
# Test command. Unset = detected per workspace (uv/pytest, npm, go, cargo, make test).
# CODEPILOT_TEST_CMD="uv run pytest -q"
# A command that regenerates traces (e.g. mock journeys). Shown to the assistant and pre-filled in the UI.
# CODEPILOT_EVAL_CMD="make eval"
# Extra trace/log folders (comma-separated, relative to the workspace or absolute).
# CODEPILOT_TRACE_DIRS=traces,eval_results
# CloudWatch log groups the assistant may search, read-only (Bedrock/AWS only). Trailing * = prefix.
# CODEPILOT_LOG_GROUPS=/aws/bedrock-agentcore/runtimes/*
# Extra skill folders (each containing <name>/SKILL.md), comma-separated.
# CODEPILOT_SKILL_DIRS=~/.claude/skills

# =============================================================================================
# 6. Behaviour
# =============================================================================================
# Skip the approval prompt for test runs and analyser checks (other commands always ask).
CODEPILOT_AUTO_APPROVE_TESTS=0
# Write proposed edits immediately instead of waiting for Apply (each can still be undone).
CODEPILOT_AUTO_APPLY=0
# The Terminal panel (a real shell as you, locked to this page by origin and token). 0 turns it off.
CODEPILOT_TERMINAL=1
# Context management (see docs/usage.md#memory). Window defaults per model; override if yours is larger.
# CODEPILOT_CONTEXT_TOKENS=200000
# Clear old tool outputs at this fraction of the budget, and summarise earlier turns at this one.
# CODEPILOT_PRUNE_AT=0.6
# CODEPILOT_COMPACT_AT=0.8
# Max model<->tool round trips per message.
# CODEPILOT_MAX_STEPS=40
# Where sessions, notes and scratch files live.
# CODEPILOT_HOME=~/.codepilot
# CODEPILOT_PORT=8765
